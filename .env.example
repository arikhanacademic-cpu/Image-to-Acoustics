# Copy to .env and fill in. Read by the backend only: never sent to the browser,
# never logged. .env is git-ignored.

# ElevenLabs (text-to-speech). Leave empty to run with an offline demo voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# mp3_44100_128 works on every plan. pcm_44100 (lossless) needs a Pro plan or higher.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Hard cap per generated clip (credit safeguard).
MAX_TTS_CHARS=600

# Image analysis. anthropic | openai | demo (demo = choose a reference environment by hand)
VISION_PROVIDER=demo
VISION_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic), gpt-4o (openai)
VISION_MODEL=
